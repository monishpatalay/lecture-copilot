# Supabase (local: values printed by `supabase start` / `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Worker connects to Postgres directly. Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# LLMs
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional, production only: a fine-grained GitHub token (this repository, Actions: read and write) that lets the
# site start the cloud worker when a lecture is uploaded. Without it the worker's 6-hourly schedule picks uploads up.
GITHUB_DISPATCH_TOKEN=

# Optional, for the worker: with all three set, the professor is emailed when a lecture is ready.
# RESEND_API_KEY is a Resend API key; EMAIL_FROM must be an address on a domain verified there.
RESEND_API_KEY=
EMAIL_FROM=
SITE_URL=
